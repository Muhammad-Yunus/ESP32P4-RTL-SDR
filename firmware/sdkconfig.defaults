# Target
CONFIG_IDF_TARGET="esp32p4"

# Chip revision: this board is ESP32-P4 rev v1.0 (early silicon).
# IDF 6.1 defaults to rev v3.1+, so explicitly enable rev<3.0 support.
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_100=y

# Flash: 32 MB QIO
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y

# PSRAM: 32 MB Octal
CONFIG_SPIRAM=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_XIP_FROM_PSRAM=y

# Optimisation
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# Disable errors for default warnings (required for third-party components
# such as esp_lvgl_adapter that emit deprecated-header #warnings under IDF 6.1)
CONFIG_COMPILER_DISABLE_DEFAULT_ERRORS=y

# FreeRTOS
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=12288

# USB Host
CONFIG_USBH_HOST_CONTROL_TRANSFER_MAX_PACKET_SIZE=4096

# LVGL
CONFIG_LV_DEF_REFR_PERIOD=15
CONFIG_LV_OS_FRERTOS=y
CONFIG_LV_DRAW_SW_DRAW_UNIT_CNT=2
CONFIG_LV_USE_FONT_COMPRESSED=y
CONFIG_LV_FONT_MONTSERRAT_12=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_FONT_MONTSERRAT_32=y
CONFIG_LV_FONT_MONTSERRAT_40=y

# Custom partition table
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x9000

# Log level
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# Coredump (for crash analysis)
CONFIG_ESP_COREDUMP_ENABLE_TO_SECOND_FLASH=y
